---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = new URL('/contact/', Astro.site).href;
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<BaseLayout
  title="Contact — RealWordCounter"
  description="Get in touch with the RealWordCounter team. Send us your feedback, bug reports, feature suggestions, or any questions about our free writing tools."
  canonical={canonical}
  ogImage="og-home.png"
>

  <div class="container" style="padding-top:var(--space-8);padding-bottom:var(--space-4)">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep">›</span>
      <span class="breadcrumb-current">Contact</span>
    </nav>
    <div class="page-header">
      <h1>Get in Touch</h1>
      <p class="page-sub">
        Have a question, found a bug, or want to suggest a new feature? We would love to hear from
        you. RealWordCounter is built for Indian students and writers — your feedback directly shapes
        what we build next.
      </p>
    </div>
  </div>

  <div class="container contact-wrap">
    <div class="contact-grid">

      <!-- ── Left: form ── -->
      <div class="contact-form-col">

        <!-- Success card shown after submission -->
        <div id="contact-success" class="success-card" style="display:none" role="alert" aria-live="polite">
          <div class="success-icon">✓</div>
          <div>
            <div class="success-title">Thank you!</div>
            <div class="success-body">We will get back to you within 48 hours.</div>
          </div>
        </div>

        <form
          id="contact-form"
          class="card card-body contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <div class="form-row">
            <div class="form-group">
              <label for="contact-name" class="form-label">
                Name <span class="form-required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="form-input"
                placeholder="Your name"
                required
                autocomplete="name"
              />
            </div>
            <div class="form-group">
              <label for="contact-email" class="form-label">
                Email <span class="form-required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="form-input"
                placeholder="your@email.com"
                required
                autocomplete="email"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject" class="form-label">Subject</label>
            <select id="contact-subject" name="subject" class="form-select">
              <option value="General Question">General Question</option>
              <option value="Bug Report">Bug Report</option>
              <option value="Feature Request">Feature Request</option>
              <option value="UPSC Tool Feedback">UPSC Tool Feedback</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-message" class="form-label">
              Message <span class="form-required" aria-hidden="true">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              class="form-textarea"
              placeholder="Describe your question, bug, or suggestion in detail..."
              rows="6"
              required
            ></textarea>
          </div>

          <button id="submit-btn" type="submit" class="btn btn-primary submit-btn">
            Send Message
          </button>
        </form>
      </div>

      <!-- ── Right: info cards ── -->
      <div class="contact-info-col">
        <div class="info-card">
          <div class="info-icon">⏱️</div>
          <div>
            <div class="info-title">Response Time</div>
            <div class="info-body">We reply within 48 hours on weekdays.</div>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">🏛️</div>
          <div>
            <div class="info-title">For UPSC Queries</div>
            <div class="info-body">Best tool for 150 and 250 word answer practice — built specifically for UPSC aspirants.</div>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">🔒</div>
          <div>
            <div class="info-title">Privacy Note</div>
            <div class="info-body">We never share your email with anyone. Your message goes directly to our inbox.</div>
          </div>
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
(function () {
  const form       = document.getElementById('contact-form') as HTMLFormElement;
  const successCard = document.getElementById('contact-success') as HTMLElement;
  const submitBtn  = document.getElementById('submit-btn') as HTMLButtonElement;

  if (!form || !successCard || !submitBtn) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Sending…';
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        successCard.style.display = 'flex';
        successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        submitBtn.textContent = 'Something went wrong — try again';
        submitBtn.disabled = false;
      }
    } catch (_) {
      submitBtn.textContent = 'Something went wrong — try again';
      submitBtn.disabled = false;
    }
  });
})();
</script>

<style>
  .page-header { margin-bottom: var(--space-8); }
  .page-header h1 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: var(--space-3); }
  .page-sub { font-size: 17px; color: var(--color-body); line-height: 1.6; max-width: 700px; margin-bottom: var(--space-4); }

  .contact-wrap { padding-bottom: var(--space-16); }

  /* Two-column layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-8);
    align-items: start;
  }

  .contact-form-col,
  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ── Form ── */
  .contact-form { display: flex; flex-direction: column; gap: var(--space-5); }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-group { display: flex; flex-direction: column; gap: var(--space-2); }

  .form-label { font-size: 14px; font-weight: 600; color: var(--color-ink); }

  .form-required { color: var(--color-error); margin-left: 2px; }

  .form-input,
  .form-select {
    width: 100%;
    height: 44px;
    padding: 0 var(--space-3);
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-textarea {
    width: 100%;
    padding: var(--space-3);
    font-size: 15px;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    resize: vertical;
    min-height: 160px;
    line-height: 1.6;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .submit-btn {
    align-self: flex-start;
    padding: var(--space-3) var(--space-8);
    font-size: 15px;
    font-weight: 600;
  }

  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* ── Success card ── */
  .success-card {
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-success-soft);
    border: 1px solid rgba(22, 163, 74, 0.25);
    border-radius: var(--radius-lg);
  }

  .success-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-success);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .success-title { font-size: 20px; font-weight: 700; color: var(--color-success); margin-bottom: 4px; }
  .success-body  { font-size: 15px; color: var(--color-body); }

  /* ── Info cards ── */
  .info-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }

  .info-icon { font-size: 22px; flex-shrink: 0; margin-top: 1px; }
  .info-title { font-size: 14px; font-weight: 700; color: var(--color-ink); margin-bottom: 4px; }
  .info-body  { font-size: 13px; color: var(--color-body); line-height: 1.5; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-info-col { flex-direction: row; flex-wrap: wrap; }
    .info-card { flex: 1 1 240px; }
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-info-col { flex-direction: column; }
    .info-card { flex: none; }
    .submit-btn { align-self: stretch; width: 100%; }
  }
</style>
