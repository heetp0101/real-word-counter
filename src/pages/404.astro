---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) — RealWordCounter"
  description="The page you're looking for doesn't exist. Head back to RealWordCounter to use our free word counter and writing tools."
  canonical="https://realwordcounter.com/404"
>

  <div class="container error-wrap">
    <div class="error-content">
      <div class="error-code" aria-hidden="true">404</div>
      <h1>Page not found</h1>
      <p class="error-desc">
        The page you're looking for doesn't exist or may have been moved.
        Here are some places to head next.
      </p>

      <a href="/" class="btn btn-primary btn-pill error-home-btn">← Back to Home</a>

      <div class="error-links-section">
        <p class="error-links-label">Popular tools</p>
        <div class="error-links-grid">
          <a href="/word-counter" class="error-link-card">
            <span class="error-link-icon">📝</span>
            <span>Word Counter</span>
          </a>
          <a href="/upsc-word-counter" class="error-link-card">
            <span class="error-link-icon">🏛️</span>
            <span>UPSC Counter</span>
          </a>
          <a href="/character-counter" class="error-link-card">
            <span class="error-link-icon">🔢</span>
            <span>Character Counter</span>
          </a>
          <a href="/readability-checker" class="error-link-card">
            <span class="error-link-icon">📖</span>
            <span>Readability Checker</span>
          </a>
          <a href="/text-case-converter" class="error-link-card">
            <span class="error-link-icon">✏️</span>
            <span>Case Converter</span>
          </a>
          <a href="/contact" class="error-link-card">
            <span class="error-link-icon">✉️</span>
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  .error-wrap {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) var(--space-4);
  }

  .error-content {
    text-align: center;
    max-width: 580px;
    width: 100%;
  }

  .error-code {
    font-size: clamp(6rem, 16vw, 10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-primary);
    opacity: 0.25;
    margin-bottom: var(--space-4);
    user-select: none;
  }

  .error-content h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-3);
  }

  .error-desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-body);
    margin-bottom: var(--space-8);
  }

  .error-home-btn {
    margin-bottom: var(--space-10);
  }

  .error-links-section {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-8);
  }

  .error-links-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-mute);
    margin-bottom: var(--space-4);
  }

  .error-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .error-link-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .error-link-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
    color: var(--color-primary);
  }

  .error-link-icon { font-size: 18px; flex-shrink: 0; }

  @media (max-width: 480px) {
    .error-links-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
